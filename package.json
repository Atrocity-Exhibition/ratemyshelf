{
  "name": "ratemyshelf",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @ratemyshelf/web dev",
    "build": "pnpm --filter @ratemyshelf/web build",
    "start": "pnpm --filter @ratemyshelf/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @ratemyshelf/db generate",
    "db:push": "pnpm --filter @ratemyshelf/db push",
    "db:migrate": "pnpm --filter @ratemyshelf/db migrate",
    "db:extras": "pnpm --filter @ratemyshelf/db extras",
    "db:deploy": "pnpm --filter @ratemyshelf/db run deploy",
    "db:seed": "pnpm --filter @ratemyshelf/db seed",
    "db:admin": "pnpm --filter @ratemyshelf/db admin",
    "db:index": "pnpm --filter @ratemyshelf/db index",
    "db:studio": "pnpm --filter @ratemyshelf/db studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
