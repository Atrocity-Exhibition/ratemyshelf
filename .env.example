# Database
# In production use a pooled connection string (Neon/Supabase pooler) for the web app.
DATABASE_URL="postgresql://ratemyshelf:ratemyshelf@localhost:5432/ratemyshelf"

# Optional: direct (non-pooled) connection for pg-boss enqueueing and the worker.
# pg-boss keeps long-lived sessions and must not go through a transaction pooler.
# QUEUE_DATABASE_URL="postgresql://ratemyshelf:ratemyshelf@localhost:5432/ratemyshelf"

# Redis (production: Upstash TCP endpoint, rediss://…)
REDIS_URL="redis://localhost:6379"

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="masterKey"
NEXT_PUBLIC_MEILISEARCH_HOST="http://localhost:7700"
# Create a search-only key scoped to the novels index; never use the master key here.
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY="searchKey"

# Auth.js
AUTH_SECRET="replace-with-a-64-character-random-string"

# Email (optional in development; when unset, new accounts are verified immediately)
RESEND_API_KEY=""
EMAIL_FROM="RateMyShelf <noreply@example.com>"

# Cloudflare R2 (optional in development)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
NEXT_PUBLIC_R2_PUBLIC_URL=""

# Public site URL used by sitemap/robots/OG metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
